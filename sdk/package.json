{
  "name": "@horkos/sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for Horkos: agent (buyer) and seller sides",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
