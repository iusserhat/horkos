{
  "name": "horkos-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Static site for Horkos: product page, MCP guide, live testnet explorer",
  "scripts": {
    "data": "node scripts/demo-history.mjs",
    "dev": "npm run data && vite",
